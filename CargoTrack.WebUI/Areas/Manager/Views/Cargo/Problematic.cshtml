@model List<ResultCargoDto>
@using CargoTrack.Entity.Entities.Enums

@{
    ViewData["Title"] = "Sorunlu Kargolar";

    string StatusCss(CargoStatus s) => s switch
    {
        CargoStatus.DeliveryFailed or CargoStatus.InReturnProcess => "ct-status-fail",
        CargoStatus.ReturnedToSender => "ct-status-done",
        _ => "ct-status-created"
    };

    string StatusLabel(CargoStatus s) => s switch
    {
        CargoStatus.DeliveryFailed => "Teslim Başarısız",
        CargoStatus.InReturnProcess => "İade Sürecinde",
        CargoStatus.ReturnedToSender => "İade Edildi",
        _ => s.ToString()
    };
}

<div class="ct-page-header">
    <div>
        <h1>Sorunlu Kargolar</h1>
        <p class="ct-subtitle">Teslim başarısız ve iade sürecindeki gönderiler.</p>
    </div>
    <a href="/Manager/Cargo/Index" class="btn btn-outline-dark btn-sm">Tüm Kargolar</a>
</div>

<div class="ct-list-card">
    <div class="table-responsive">
        @if (Model == null || !Model.Any())
        {
            <div class="ct-empty">Sorunlu kargo yok.</div>
        }
        else
        {
            <table class="ct-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Takip No</th>
                        <th>Durum</th>
                        <th>Gönderim</th>
                        <th>ETA</th>
                        <th class="text-center">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int count = 0;
                    }
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td class="text-muted small">@count</td>
                            <td><span class="ct-track">@item.TrackCode</span></td>
                            <td>
                                <span class="ct-status @StatusCss(item.CargoStatus)">
                                    <span class="dot"></span>@StatusLabel(item.CargoStatus)
                                </span>
                            </td>
                            <td>@item.ShipmentDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.EstimatedArrivalDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-center">
                                <a href="/Manager/Cargo/ChangeStatus/@item.Id" class="btn btn-sm btn-outline-dark me-1">Durum</a>
                                <a href="/Manager/Cargo/Details/@item.Id" class="btn btn-sm btn-outline-dark">Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="ct-list-footer">Toplam <strong>@(Model?.Count ?? 0)</strong> gönderi</div>
</div>
