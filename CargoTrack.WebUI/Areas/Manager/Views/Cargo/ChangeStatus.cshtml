@model ChangeCargoStatusDto

@{
    ViewData["Title"] = "Durum Değiştir";
}

<div class="ct-page-header">
    <div>
        <h1>Kargo Durumu Değiştir</h1>
        <p class="ct-subtitle">İzin verilen durum geçişlerini uygulayın. Teslim için teslimat kodu gerekir.</p>
    </div>
    <a href="/Manager/Cargo/Index" class="btn btn-outline-dark btn-sm">Listeye Dön</a>
</div>

@if (ViewBag.error != null)
{
    <div class="alert alert-danger">@ViewBag.error</div>
}

<div class="ct-form-card">
    <form method="post">
        <input type="hidden" asp-for="CargoId" />

        <div class="mb-3">
            <label asp-for="NewStatus" class="form-label">Yeni Durum</label>
            <select asp-for="NewStatus" asp-items="ViewBag.statuses" class="form-select"></select>
        </div>

        <div class="mb-3">
            <label asp-for="TransferCenterId" class="form-label">Transfer merkezi (Transfer Merkezinde için zorunlu)</label>
            <select asp-for="TransferCenterId" asp-items="ViewBag.transferCenters" class="form-select">
                <option value="">Seçiniz</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Açıklama (opsiyonel)</label>
            <input asp-for="Description" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="DeliveryCode" class="form-label">Teslimat kodu (yalnızca Teslim Edildi)</label>
            <input asp-for="DeliveryCode" class="form-control" maxlength="6" placeholder="6 haneli kod" />
            <div class="form-text">Alıcıya iletilen DeliveryCode ile birebir eşleşmelidir.</div>
        </div>

        <div class="mb-3">
            <label asp-for="ReceivedByName" class="form-label">Teslim alan (yalnızca Teslim Edildi)</label>
            <input asp-for="ReceivedByName" class="form-control" />
        </div>

        <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-dark">Kaydet</button>
            <a href="/Manager/Cargo/Index" class="btn btn-outline-dark">İptal</a>
        </div>
    </form>
</div>
