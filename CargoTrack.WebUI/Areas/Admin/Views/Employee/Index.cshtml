@model List<ResultEmployeeDto>

@{
    ViewData["Title"] = "Çalışanlar";
    int count = 0;
}

<div class="ct-page-header">
    <div>
        <h1>Çalışanlar</h1>
        <p class="ct-subtitle">Personel dizini — şube ve ünvan eşlemesi.</p>
    </div>
    <a href="/Admin/Employee/Create" class="btn btn-dark btn-sm">Yeni Çalışan</a>
</div>

<div class="ct-list-card">
    <div class="table-responsive">
        <table class="ct-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Ünvan</th>
                    <th>Şube</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td class="text-muted small">@count</td>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Title</td>
                        <td>@(item.BranchName ?? item.BranchId.ToString())</td>
                        <td class="text-center">
                            <a href="/Admin/Employee/Update/@item.Id" class="btn btn-sm btn-outline-dark me-1">Güncelle</a>
                            <a href="/Admin/Employee/Delete/@item.Id" onclick="return confirm('Silmek istediğinize emin misiniz?')" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="ct-list-footer">Toplam <strong>@count</strong> çalışan</div>
</div>
