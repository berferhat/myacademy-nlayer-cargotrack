@model List<ResultTransferCenterDto>

@{
    ViewData["Title"] = "Transfer Merkezleri";
    int count = 0;
}

<div class="ct-page-header">
    <div>
        <h1>Transfer Merkezleri</h1>
        <p class="ct-subtitle">Lojistik hub kayıtları.</p>
    </div>
    <a href="/Admin/TransferCenter/Create" class="btn btn-dark btn-sm">Yeni Transfer Merkezi</a>
</div>

<div class="ct-list-card">
    <div class="table-responsive">
        <table class="ct-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>İsim</th>
                    <th>Şehir</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td class="text-muted small">@count</td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@(item.CityName ?? item.CityId.ToString())</td>
                        <td class="text-center">
                            <a href="/Admin/TransferCenter/Update/@item.Id" class="btn btn-sm btn-outline-dark me-1">Güncelle</a>
                            <a href="/Admin/TransferCenter/Delete/@item.Id" onclick="return confirm('Silmek istediğinize emin misiniz?')" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="ct-list-footer">Toplam <strong>@count</strong> merkez</div>
</div>
