@model CreateBranchDto

@{
    ViewData["Title"] = "Yeni Şube";
}

<div class="ct-page-header">
    <div>
        <h1>Yeni Şube</h1>
        <p class="ct-subtitle">Şube adı ve şehir seçimi.</p>
    </div>
    <a href="/Admin/Branch" class="btn btn-outline-dark btn-sm">Listeye Dön</a>
</div>

<div class="ct-form-card">
    <form method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="Name">Şube İsmi</label>
            <input type="text" asp-for="Name" class="form-control" />
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="CityId">Şehir</label>
            <select asp-for="CityId" class="form-select" asp-items="@ViewBag.cities">
                <option disabled selected>---Şehir Seçiniz---</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-dark" type="submit">Kaydet</button>
            <a href="/Admin/Branch" class="btn btn-outline-dark">İptal</a>
        </div>
    </form>
</div>
