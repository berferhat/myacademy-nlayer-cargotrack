@model List<ResultBranchDto>

@{
    ViewData["Title"] = "Şubeler";
    int count = 0;
}

<div class="ct-page-header">
    <div>
        <h1>Şubeler</h1>
        <p class="ct-subtitle">Şube kayıtlarını yönetin (soft delete destekli).</p>
    </div>
    <a href="/Admin/Branch/Create" class="btn btn-dark btn-sm">Yeni Şube</a>
</div>

<div class="ct-list-card">
    <div class="table-responsive">
        <table class="ct-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Şube İsmi</th>
                    <th>Şehir</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td class="text-muted small">@count</td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.City.Name</td>
                        <td class="text-center">
                            <a href="/Admin/Branch/Update/@item.Id" class="btn btn-sm btn-outline-dark me-1">Güncelle</a>
                            <a href="/Admin/Branch/Delete/@item.Id" onclick="return confirm('Silmek istediğinize emin misiniz?')" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="ct-list-footer">Toplam <strong>@count</strong> şube</div>
</div>
