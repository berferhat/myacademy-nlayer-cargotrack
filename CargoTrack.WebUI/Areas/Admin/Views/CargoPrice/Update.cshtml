@model UpdateCargoPriceDto

@{
    ViewData["Title"] = "Fiyat Güncelle";
}

<div class="ct-page-header">
    <div>
        <h1>Fiyat Güncelle</h1>
        <p class="ct-subtitle">Fiyat katmanını düzenleyin.</p>
    </div>
    <a href="/Admin/CargoPrice" class="btn btn-outline-dark btn-sm">Listeye Dön</a>
</div>

<div class="ct-form-card">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label" asp-for="Name">Ad</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="CargoType">Kargo Tipi</label>
            <select asp-for="CargoType" class="form-select" asp-items="@ViewBag.cargoTypes">
                <option value="">---Seçiniz---</option>
            </select>
        </div>
        <div class="row g-3">
            <div class="col-md-4 mb-3">
                <label class="form-label" asp-for="BasePrice">Taban Fiyat</label>
                <input asp-for="BasePrice" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" asp-for="PricePerKg">Kg Başı</label>
                <input asp-for="PricePerKg" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" asp-for="PricePerDesi">Desi Başı</label>
                <input asp-for="PricePerDesi" class="form-control" />
            </div>
        </div>
        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label class="form-check-label" asp-for="IsActive">Aktif</label>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-dark" type="submit">Güncelle</button>
            <a href="/Admin/CargoPrice" class="btn btn-outline-dark">İptal</a>
        </div>
    </form>
</div>
