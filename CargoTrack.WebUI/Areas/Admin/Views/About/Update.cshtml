@model UpdateAboutDto

@{
    ViewData["Title"] = "Hakkımızda Güncelle";
}

<div class="ct-page-header">
    <div>
        <h1>Hakkımızda Güncelle</h1>
        <p class="ct-subtitle">İçerik bloğunu düzenleyin.</p>
    </div>
    <a href="/Admin/About" class="btn btn-outline-dark btn-sm">Listeye Dön</a>
</div>

<div class="ct-form-card">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label" asp-for="ImageUrl">Görsel Url</label>
            <input type="text" asp-for="ImageUrl" class="form-control" />
            <span class="text-danger" asp-validation-for="ImageUrl"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Title">Başlık</label>
            <input type="text" asp-for="Title" class="form-control" />
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Description">Açıklama</label>
            <input type="text" asp-for="Description" class="form-control" />
            <span class="text-danger" asp-validation-for="Description"></span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-dark" type="submit">Güncelle</button>
            <a href="/Admin/About" class="btn btn-outline-dark">İptal</a>
        </div>
    </form>
</div>
