@model AdminReportDto

@{
    ViewData["Title"] = "Raporlar";
}

<div class="ct-page-header">
    <div>
        <h1>Performans Raporları</h1>
        <p class="ct-subtitle">Teslim SLA, şube performansı ve son 7 gün hacim özeti.</p>
    </div>
</div>

<div class="ct-metric-grid">
    <div class="ct-metric-card">
        <div>
            <p class="ct-metric-label">Teslim başarı oranı</p>
            <div class="ct-metric-value">%@Model.DeliverySuccessPercent</div>
        </div>
        <div class="ct-metric-icon green"><span class="material-symbols-outlined">check_circle</span></div>
    </div>
    <div class="ct-metric-card">
        <div>
            <p class="ct-metric-label">İade oranı</p>
            <div class="ct-metric-value">%@Model.ReturnPercent</div>
        </div>
        <div class="ct-metric-icon amber"><span class="material-symbols-outlined">undo</span></div>
    </div>
    <div class="ct-metric-card">
        <div>
            <p class="ct-metric-label">Geciken kargo</p>
            <div class="ct-metric-value">@Model.DelayedCargoCount</div>
        </div>
        <div class="ct-metric-icon orange"><span class="material-symbols-outlined">schedule</span></div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="ct-list-card h-100">
            <div class="ct-list-toolbar"><strong style="color:var(--ct-primary)">En çok gönderen şubeler</strong></div>
            <div class="table-responsive">
                <table class="ct-table">
                    <thead><tr><th>Şube</th><th class="text-end">Adet</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.TopSendingBranches)
                        {
                            <tr><td>@b.BranchName</td><td class="text-end fw-bold">@b.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="ct-list-card h-100">
            <div class="ct-list-toolbar"><strong style="color:var(--ct-primary)">En çok teslim alan şubeler</strong></div>
            <div class="table-responsive">
                <table class="ct-table">
                    <thead><tr><th>Şube</th><th class="text-end">Adet</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.TopReceivingBranches)
                        {
                            <tr><td>@b.BranchName</td><td class="text-end fw-bold">@b.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="ct-list-card h-100">
            <div class="ct-list-toolbar"><strong style="color:var(--ct-primary)">Geciken şubeler (varış)</strong></div>
            <div class="table-responsive">
                <table class="ct-table">
                    <thead><tr><th>Şube</th><th class="text-end">Adet</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.DelayedBranches)
                        {
                            <tr><td>@b.BranchName</td><td class="text-end fw-bold">@b.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="ct-chart-wrap">
            <h2>Son 7 gün hacim</h2>
            <canvas id="volumeChart" height="200"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysVolume.Select(x => x.DayLabel)));
        const counts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysVolume.Select(x => x.Count)));
        new Chart(document.getElementById('volumeChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{ label: 'Kargo', data: counts, backgroundColor: '#fd8b00' }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
