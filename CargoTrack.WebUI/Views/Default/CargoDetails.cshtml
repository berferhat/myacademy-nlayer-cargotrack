@using CargoTrack.DTO.DTOs.CargoDtos
@model CargoTrackResultDto

@{
    ViewData["Title"] = "Gönderi Detayı";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
    <div>
        <p class="text-label-sm font-label-sm tracking-wider uppercase text-on-surface-variant mb-1">Kamu Takip Özeti</p>
        <h1 class="text-headline-lg font-headline-lg text-primary-container mb-2">Gönderi Detayları</h1>
        <p class="text-on-surface-variant font-body-md">Kişisel veriler maskelenmiştir. Teslimat kodu bu ekranda gösterilmez.</p>
    </div>
    <div class="flex gap-3 w-full md:w-auto">
        <button type="button" onclick="window.print()"
                class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-surface-container-lowest text-primary-container border border-outline-variant px-4 py-2.5 rounded-lg font-label-md font-semibold hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">print</span>
            Yazdır
        </button>
        <a href="/Default/Index"
           class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-secondary-container text-on-primary px-6 py-2.5 rounded-lg font-label-md font-semibold hover:bg-[#e07b00] transition-colors no-underline">
            <span class="material-symbols-outlined">search</span>
            Yeni Sorgula
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <div class="lg:col-span-8 flex flex-col gap-6">
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-6 flex flex-col md:flex-row gap-8">
            <div class="flex-1 border-r-0 md:border-r border-outline-variant pr-0 md:pr-6">
                <div class="mb-6">
                    <p class="text-label-sm font-label-sm text-outline mb-1 uppercase tracking-wider">Takip Numarası</p>
                    <h2 class="font-code-tabular text-code-tabular text-headline-md text-primary-container">@Model.TrackCode</h2>
                </div>
                <div class="inline-flex items-center gap-1.5 bg-surface-container-high text-primary-container px-3 py-1 rounded-full text-label-sm font-label-sm mb-6">
                    <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                    @Model.CargoStatus
                </div>
                <div class="flex gap-8">
                    <div>
                        <p class="text-body-sm text-outline mb-1">Gönderim Tarihi</p>
                        <p class="font-semibold text-on-background">@Model.ShipmentDate</p>
                    </div>
                    <div>
                        <p class="text-body-sm text-outline mb-1">Tahmini Varış</p>
                        <p class="font-semibold text-on-background">@Model.EstimatedArrivalDate</p>
                    </div>
                </div>
            </div>
            <div class="flex-1 flex flex-col justify-center">
                <div class="flex justify-between items-center mb-2">
                    <div class="flex flex-col items-center text-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center mb-2 text-primary-container">
                            <span class="material-symbols-outlined text-[18px] filled-icon">location_on</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.OriginCityName</span>
                        <span class="text-xs text-outline">@Model.OriginBranchName</span>
                    </div>
                    <div class="flex-grow flex items-center px-2">
                        <div class="flex-grow h-px bg-outline-variant relative">
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-surface-container-lowest px-2">
                                <span class="material-symbols-outlined text-secondary-container filled-icon">local_shipping</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-col items-center text-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container text-outline flex items-center justify-center mb-2">
                            <span class="material-symbols-outlined text-[18px]">flag</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.DestinationCityName</span>
                        <span class="text-xs text-outline">@Model.DestinationBranchName</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined">warehouse</span>
                </div>
                <div>
                    <p class="text-label-sm font-label-sm text-outline mb-1 uppercase">Çıkış</p>
                    <p class="font-semibold text-on-background">@Model.OriginCityName</p>
                    <p class="text-sm text-on-surface-variant">@Model.OriginBranchName</p>
                </div>
            </div>
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined">flag</span>
                </div>
                <div>
                    <p class="text-label-sm font-label-sm text-outline mb-1 uppercase">Varış</p>
                    <p class="font-semibold text-on-background">@Model.DestinationCityName</p>
                    <p class="text-sm text-on-surface-variant">@Model.DestinationBranchName</p>
                </div>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-6">
            <h3 class="text-headline-sm font-headline-sm text-primary-container mb-4">Hareket Geçmişi</h3>
            @if (Model.Movements != null && Model.Movements.Any())
            {
                <ul class="space-y-3">
                    @foreach (var movement in Model.Movements)
                    {
                        <li class="flex flex-col gap-1 border-b border-outline-variant pb-3 last:border-0">
                            <span class="font-semibold text-on-background">@movement.NewStatus</span>
                            <span class="text-sm text-on-surface-variant">@movement.MovementDate</span>
                            @if (!string.IsNullOrWhiteSpace(movement.BranchName))
                            {
                                <span class="text-sm text-outline">@movement.BranchName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(movement.Description))
                            {
                                <span class="text-sm text-on-surface-variant">@movement.Description</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-on-surface-variant">Henüz hareket kaydı yok.</p>
            }
        </div>
    </div>
</div>
