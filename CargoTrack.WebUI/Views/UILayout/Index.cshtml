@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isTrackPage = string.Equals(currentController, "Default", StringComparison.OrdinalIgnoreCase);
    var isLoginPage = string.Equals(currentController, "Login", StringComparison.OrdinalIgnoreCase);
    var isRegisterPage = string.Equals(currentController, "Register", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@(ViewData["Title"] ?? "Kargo Takip") - CargoTrack</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..900;1,300..900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <partial name="_StitchTailwindConfig" />
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex flex-col antialiased">
    <header class="bg-surface-container-lowest sticky top-0 z-50 border-b border-outline-variant">
        <div class="w-full h-16 flex justify-between items-center max-w-[1200px] mx-auto px-margin-sm md:px-margin">
            <div class="flex items-center gap-space-xl min-w-0">
                <a class="flex items-center gap-2 shrink-0" href="/Default/Index">
                    <img src="~/images/cargotrack-logo.svg"
                         alt="CargoTrack"
                         class="h-9 md:h-10 w-auto"
                         asp-append-version="true" />
                </a>
                <nav class="hidden md:flex items-center gap-6">
                    <a class="@(isTrackPage
                           ? "text-primary-container font-label-md text-label-md font-bold border-b-2 border-secondary-container pb-1"
                           : "text-on-surface-variant font-label-md text-label-md hover:text-primary-container transition-colors duration-150")"
                       href="/Default/Index">
                        Kargo Takip
                    </a>
                </nav>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-on-surface-variant text-label-md hidden sm:inline">@User.Identity.Name</span>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Dashboard" class="px-4 py-2 text-label-md font-label-md border border-outline-variant rounded-lg text-primary-container bg-surface-container-lowest hover:bg-surface-container-low transition-colors duration-150">Panele Git</a>
                    }
                    else if (User.IsInRole("Manager"))
                    {
                        <a href="/Manager/Dashboard" class="px-4 py-2 text-label-md font-label-md border border-outline-variant rounded-lg text-primary-container bg-surface-container-lowest hover:bg-surface-container-low transition-colors duration-150">Panele Git</a>
                    }
                    else if (User.IsInRole("User"))
                    {
                        <a href="/User/Dashboard" class="px-4 py-2 text-label-md font-label-md border border-outline-variant rounded-lg text-primary-container bg-surface-container-lowest hover:bg-surface-container-low transition-colors duration-150">Panele Git</a>
                    }
                    <a href="/Login/Logout"
                       class="px-4 py-2 text-label-md font-label-md rounded-lg text-on-primary bg-primary-container hover:bg-[#0a2d54] transition-colors duration-150">
                        Çıkış
                    </a>
                }
                else
                {
                    <a href="/Login"
                       class="@(isLoginPage
                           ? "text-primary-container font-bold border-b-2 border-secondary-container pb-1 text-label-md font-label-md px-1"
                           : "px-4 py-2 rounded-lg text-label-md font-label-md text-on-surface-variant hover:bg-surface-container-low transition-colors duration-150")">
                        Giriş
                    </a>
                    <a href="/Register/Signup"
                       class="@(isRegisterPage
                           ? "px-4 py-2 rounded-lg text-label-md font-label-md bg-primary-container text-on-primary"
                           : "px-4 py-2 rounded-lg text-label-md font-label-md bg-primary-container text-on-primary hover:bg-[#0a2d54] transition-colors duration-150")">
                        Kayıt
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="flex-grow w-full">
        <div class="max-w-[1200px] mx-auto w-full px-margin-sm md:px-margin py-10 md:py-12">
            @RenderBody()
        </div>
    </main>

    <footer class="w-full bg-primary-container border-t border-primary mt-auto">
        <div class="w-full py-space-xl px-margin-sm md:px-margin max-w-[1200px] mx-auto flex flex-col md:flex-row justify-between items-center gap-space-md text-on-primary-container">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-[20px]">corporate_fare</span>
                <span class="text-body-sm font-body-sm">© 2026 CargoTrack. Tüm hakları saklıdır.</span>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
